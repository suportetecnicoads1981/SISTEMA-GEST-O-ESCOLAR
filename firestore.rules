rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar para verificar autenticação
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função para verificar se a conta técnica autorizada está realizando a operação
    function isTechnicalAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'suportetecnicoads@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Função de isolamento Multi-Tenant estrito
    function belongsToTenant(tenantId) {
      return isAuthenticated() && (
        request.auth.token.tenant_id == tenantId ||
        isTechnicalAdmin()
      );
    }

    // Regras de Autenticação & Configurações de Tenants
    match /tenants_auth_configs/{tenantId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if isTechnicalAdmin();
    }

    // Módulo CRM: Leads & Oportunidades
    match /crm_leads_opportunities/{docId} {
      allow read, write: if isAuthenticated() && (
        isTechnicalAdmin() ||
        (request.resource.data.tenant_id == request.auth.token.tenant_id)
      );
    }

    // Módulo CRM: Contas & Contatos
    match /crm_accounts_contacts/{docId} {
      allow read, write: if isAuthenticated() && (
        isTechnicalAdmin() ||
        (request.resource.data.tenant_id == request.auth.token.tenant_id)
      );
    }

    // Módulo Financeiro: Contas a Receber
    match /fin_accounts_receivable/{docId} {
      allow read, write: if isAuthenticated() && (
        isTechnicalAdmin() ||
        (request.resource.data.tenant_id == request.auth.token.tenant_id)
      );
    }

    // Módulo Financeiro: Contas a Pagar
    match /fin_accounts_payable/{docId} {
      allow read, write: if isAuthenticated() && (
        isTechnicalAdmin() ||
        (request.resource.data.tenant_id == request.auth.token.tenant_id)
      );
    }

    // Módulo Financeiro: Livro Razão e Lançamentos Contábeis
    match /fin_ledger_entries/{docId} {
      allow read: if isAuthenticated() && (
        isTechnicalAdmin() ||
        (resource.data.tenant_id == request.auth.token.tenant_id)
      );
      allow write: if isAuthenticated() && (
        isTechnicalAdmin() ||
        (request.resource.data.tenant_id == request.auth.token.tenant_id)
      );
    }

    // Módulo Inventário: Itens de Estoque
    match /inv_stock_items/{docId} {
      allow read, write: if isAuthenticated() && (
        isTechnicalAdmin() ||
        (request.resource.data.tenant_id == request.auth.token.tenant_id)
      );
    }

    // Módulo Inventário: Movimentações de Estoque (Lotes e Rastreabilidade)
    match /inv_stock_movements/{docId} {
      allow read, write: if isAuthenticated() && (
        isTechnicalAdmin() ||
        (request.resource.data.tenant_id == request.auth.token.tenant_id)
      );
    }

    // Histórico de Releases e Auditoria do NexusCore
    match /nexuscore_releases/{releaseId} {
      allow read: if isAuthenticated();
      allow write: if isTechnicalAdmin();
    }

    // Snapshots de Segurança do Cloud Storage
    match /nexuscore_snapshots/{snapshotId} {
      allow read: if isTechnicalAdmin();
      allow write: if isTechnicalAdmin();
    }

    // Bloqueio padrão para todas as outras coleções não mapeadas
    match /{document=**} {
      allow read, write: if isTechnicalAdmin();
    }
  }
}
